POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kampong_ride
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:changeme@localhost:5432/kampong_ride

# Basic-auth password guarding /database (and other internal/admin routes).
ADMIN_PASSWORD=changeme

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# GA4 Measurement Protocol API secret (GA Admin > Data streams > Measurement Protocol API secrets).
# Enables the server-side waitlist_signup event. Leave empty to disable.
GA_API_SECRET=
